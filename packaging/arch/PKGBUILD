# Arch Linux / CachyOS / Manjaro paketi (GitHub'daki son sürümden derler).
#   cd packaging/arch && makepkg -si
# Maintainer: hamer1818

pkgname=manual-duplex-print-git
_repo=manual-duplex-print
pkgver=1.0.0
pkgrel=1
pkgdesc="Manual two-sided, 2/4-up and A5 booklet printing for printers without a duplex unit (Yazdır)"
arch=(any)
url="https://github.com/hamer1818/manual-duplex-print"
license=(MIT)
depends=(python python-pypdf pyside6 python-pycups cups poppler)
optdepends=('libreoffice-fresh: Word, ODT, PowerPoint and spreadsheet files'
            'imagemagick: image files')
makedepends=(git python-build python-installer python-setuptools python-wheel)
provides=(manual-duplex-print)
conflicts=(manual-duplex-print)
source=("git+$url.git")
sha256sums=(SKIP)

pkgver() {
  cd "$_repo"
  local surum
  surum=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' yazdir/__init__.py)
  printf "%s.r%s.%s" "$surum" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_repo"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_repo"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$_repo"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/yazdir.desktop "$pkgdir/usr/share/applications/yazdir.desktop"
  install -Dm755 packaging/yazdir-servicemenu.desktop "$pkgdir/usr/share/kio/servicemenus/yazdir.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
